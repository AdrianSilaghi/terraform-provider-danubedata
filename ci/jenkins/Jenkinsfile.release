boolean isExactSemverTag(String tag) {
    if (!(tag ==~ /v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?/)) {
        return false
    }

    String versionWithoutBuild = tag.substring(1).split('\\+', 2)[0]
    int prereleaseSeparator = versionWithoutBuild.indexOf('-')
    if (prereleaseSeparator < 0) {
        return true
    }

    for (String identifier : versionWithoutBuild.substring(prereleaseSeparator + 1).split('\\.')) {
        if (identifier ==~ /[0-9]+/ && identifier.length() > 1 && identifier.startsWith('0')) {
            return false
        }
    }
    return true
}

pipeline {
    agent { label 'trusted-build' }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '20'))
    }

    parameters {
        string(name: 'SOURCE_REF', defaultValue: '', description: 'Required full tag ref, for example refs/tags/v0.4.0.')
        string(name: 'SOURCE_SHA', defaultValue: '', description: 'Required immutable commit SHA targeted by the tag.')
        string(name: 'SOURCE_REPOSITORY', defaultValue: 'AdrianSilaghi/terraform-provider-danubedata', description: 'Canonical repository full name.')
        booleanParam(name: 'PUBLISH_RELEASE', defaultValue: false, description: 'False performs a credential-free snapshot. Real publishing remains hard-disabled in trusted main.')
    }

    environment {
        CANONICAL_REPOSITORY = 'AdrianSilaghi/terraform-provider-danubedata'
        SOURCE_URL = 'https://github.com/AdrianSilaghi/terraform-provider-danubedata.git'
        GO_IMAGE = 'golang:1.24.12-bookworm@sha256:44dd2dbf7b34b282ccd04e88cdf81dc93d38812ffd91c47cca8a11736860f55e'
        GORELEASER_IMAGE = 'goreleaser/goreleaser:v2.13.3@sha256:ee951e2c1fe3602956782aaba1dcf43cc4281a01585b7ec67bf042689f31d2fc'
        VERIFIED_MAIN_REF = 'refs/remotes/origin/main'
        REAL_RELEASE_ENABLED = 'false'
    }

    stages {
        stage('Validate trusted release request') {
            steps {
                script {
                    if (env.JOB_NAME != 'terraform-provider-danubedata-release/github') {
                        error("This trusted pipeline cannot run as job ${env.JOB_NAME ?: 'unset'}")
                    }
                    if (params.SOURCE_REPOSITORY.trim() != env.CANONICAL_REPOSITORY) {
                        error("Unexpected source repository: ${params.SOURCE_REPOSITORY ?: 'unset'}")
                    }

                    String sourceRef = params.SOURCE_REF.trim()
                    if (!(sourceRef ==~ /refs\/tags\/v[^\/]+/)) {
                        error("Release source must be one full tag ref, got ${sourceRef ?: 'unset'}")
                    }
                    String releaseTag = sourceRef.substring('refs/tags/'.length())
                    if (!isExactSemverTag(releaseTag)) {
                        error("Release tag is not exact SemVer: ${releaseTag}")
                    }

                    String sourceSha = params.SOURCE_SHA.trim()
                    if (!(sourceSha ==~ /[0-9a-fA-F]{40}/)) {
                        error("Invalid SOURCE_SHA: ${sourceSha ?: 'unset'}")
                    }
                    if (params.PUBLISH_RELEASE && env.REAL_RELEASE_ENABLED != 'true') {
                        error('Real provider releases are disabled in trusted main; run the credential-free snapshot instead')
                    }

                    env.RELEASE_TAG = releaseTag
                    env.EXPECTED_SOURCE_SHA = sourceSha
                    env.VERIFIED_TAG_REF = sourceRef
                    env.CHECKOUT_REFSPEC = "+${sourceRef}:${sourceRef} +refs/heads/main:refs/remotes/origin/main"
                }
            }
        }

        stage('Verify tag and project') {
            steps {
                deleteDir()
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: env.VERIFIED_TAG_REF]],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [[$class: 'CloneOption', honorRefspec: true, noTags: false, shallow: false]],
                    userRemoteConfigs: [[
                        url: env.SOURCE_URL,
                        refspec: env.CHECKOUT_REFSPEC
                    ]]
                ])

                script {
                    String checkedOutSha = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    String tagCommit = sh(
                        script: "git rev-parse '${env.VERIFIED_TAG_REF}^{commit}'",
                        returnStdout: true
                    ).trim()
                    if (!checkedOutSha.equalsIgnoreCase(tagCommit)) {
                        error("HEAD ${checkedOutSha} does not match tag commit ${tagCommit}")
                    }
                    if (!tagCommit.equalsIgnoreCase(env.EXPECTED_SOURCE_SHA)) {
                        error("Tag commit ${tagCommit} does not match SOURCE_SHA ${env.EXPECTED_SOURCE_SHA}")
                    }
                    env.VERIFIED_TAG_COMMIT = tagCommit

                    int trustedMainStatus = sh(
                        script: 'git merge-base --is-ancestor "$VERIFIED_TAG_COMMIT" "$VERIFIED_MAIN_REF"',
                        returnStatus: true
                    )
                    if (trustedMainStatus != 0) {
                        error("Tag ${env.RELEASE_TAG} is not reachable from protected main")
                    }
                }

                sh '''
                    set -eu
                    GO_MOD_CACHE="$WORKSPACE_TMP/terraform-provider-go-mod"
                    rm -rf "$GO_MOD_CACHE"
                    mkdir -p "$GO_MOD_CACHE"
                    test "$(git rev-parse "refs/tags/$RELEASE_TAG^{commit}")" = "$VERIFIED_TAG_COMMIT"
                    test "$(git tag --points-at "$VERIFIED_TAG_COMMIT" | grep -Fx "$RELEASE_TAG")" = "$RELEASE_TAG"
                    grep -Fx 'module github.com/AdrianSilaghi/terraform-provider-danubedata' go.mod
                    grep -Fq "binary: '{{ .ProjectName }}_v{{ .Version }}'" .goreleaser.yml
                    grep -Fq 'registry.terraform.io/AdrianSilaghi/danubedata' main.go
                    grep -Fq '"protocol_versions": ["6.0"]' terraform-registry-manifest.json

                    docker run --rm --platform linux/amd64 \
                        --user "$(id -u):$(id -g)" \
                        -e GOCACHE=/tmp/go-build \
                        -e GOMODCACHE=/tmp/go-mod \
                        -v "$WORKSPACE:/workspace" \
                        -v "$GO_MOD_CACHE:/tmp/go-mod" \
                        -w /workspace \
                        "$GO_IMAGE" \
                        bash -ceu '
                            test "$(go list -m)" = github.com/AdrianSilaghi/terraform-provider-danubedata
                            go mod download
                            go mod tidy
                            go mod verify
                        '
                    git diff --exit-code -- go.mod go.sum
                '''
            }
        }

        stage('GoReleaser') {
            steps {
                script {
                    if (!params.PUBLISH_RELEASE) {
                        sh '''
                            set -eu
                            GO_MOD_CACHE="$WORKSPACE_TMP/terraform-provider-go-mod"
                            GORELEASER_HOME="$WORKSPACE_TMP/terraform-provider-goreleaser-home"
                            test -d "$GO_MOD_CACHE"
                            rm -rf "$GORELEASER_HOME"
                            mkdir -p "$GORELEASER_HOME"
                            docker run --rm --platform linux/amd64 \
                                --user "$(id -u):$(id -g)" \
                                -e HOME=/tmp/home \
                                -e GOCACHE=/tmp/go-build \
                                -e GOMODCACHE=/tmp/go-mod \
                                -v "$WORKSPACE:/workspace" \
                                -v "$GO_MOD_CACHE:/tmp/go-mod" \
                                -v "$GORELEASER_HOME:/tmp/home" \
                                -w /workspace \
                                "$GORELEASER_IMAGE" \
                                release --snapshot --clean --skip=sign --release-notes=/dev/null
                            test -s dist/artifacts.json
                        '''
                    } else {
                        if (env.REAL_RELEASE_ENABLED != 'true') {
                            error('Real provider releases are disabled in this trusted pipeline revision')
                        }
                        withCredentials([
                            string(
                                credentialsId: 'terraform-provider-github-release-token',
                                variable: 'GITHUB_TOKEN'
                            ),
                            file(
                                credentialsId: 'terraform-provider-gpg-private-key',
                                variable: 'GPG_PRIVATE_KEY_FILE'
                            ),
                            string(
                                credentialsId: 'terraform-provider-gpg-passphrase',
                                variable: 'GPG_PASSPHRASE'
                            )
                        ]) {
                            sh '''
                                set -eu
                                set +x
                                [ -n "$GITHUB_TOKEN" ]
                                [ -s "$GPG_PRIVATE_KEY_FILE" ]
                                GO_MOD_CACHE="$WORKSPACE_TMP/terraform-provider-go-mod"
                                GORELEASER_HOME="$WORKSPACE_TMP/terraform-provider-goreleaser-home"
                                test -d "$GO_MOD_CACHE"
                                GPG_HOME="$WORKSPACE_TMP/terraform-provider-gpg-$BUILD_NUMBER"
                                trap 'rm -rf "$GPG_HOME" "$GORELEASER_HOME"' EXIT HUP INT TERM
                                rm -rf "$GPG_HOME"
                                rm -rf "$GORELEASER_HOME"
                                mkdir -m 700 "$GPG_HOME" "$GORELEASER_HOME"

                                docker run --rm --platform linux/amd64 \
                                    --user "$(id -u):$(id -g)" \
                                    -e HOME=/tmp/home \
                                    -e GOCACHE=/tmp/go-build \
                                    -e GOMODCACHE=/tmp/go-mod \
                                    -e GITHUB_TOKEN \
                                    -e GPG_PASSPHRASE \
                                    -v "$WORKSPACE:/workspace" \
                                    -v "$GO_MOD_CACHE:/tmp/go-mod" \
                                    -v "$GORELEASER_HOME:/tmp/home" \
                                    -v "$GPG_HOME:/tmp/gnupg" \
                                    -v "$GPG_PRIVATE_KEY_FILE:/run/secrets/gpg-private-key:ro" \
                                    -w /workspace \
                                    --entrypoint /bin/sh \
                                    "$GORELEASER_IMAGE" \
                                    -ceu '
                                        export GNUPGHOME=/tmp/gnupg
                                        chmod 700 "$GNUPGHOME"
                                        gpg --batch --import /run/secrets/gpg-private-key
                                        GPG_FINGERPRINT="$(gpg --batch --with-colons --list-secret-keys | awk -F: '\''$1 == "fpr" { print $10; exit }'\'')"
                                        printf "%s" "$GPG_FINGERPRINT" | grep -Eq "^[0-9A-Fa-f]{40,64}$"
                                        export GPG_FINGERPRINT
                                        goreleaser release --clean
                                    '
                            '''
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts allowEmptyArchive: true,
                        artifacts: 'dist/**/*',
                        fingerprint: true
                    sh 'rm -rf "$WORKSPACE_TMP/terraform-provider-go-mod" "$WORKSPACE_TMP/terraform-provider-goreleaser-home"'
                }
            }
        }
    }
}
