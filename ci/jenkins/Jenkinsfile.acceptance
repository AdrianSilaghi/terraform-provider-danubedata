pipeline {
    agent none

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 75, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    parameters {
        string(name: 'SOURCE_REF', defaultValue: 'refs/heads/main', description: 'Protected main ref only.')
        string(name: 'SOURCE_SHA', defaultValue: '', description: 'Required immutable protected main tip SHA.')
        string(name: 'SOURCE_REPOSITORY', defaultValue: 'AdrianSilaghi/terraform-provider-danubedata', description: 'Canonical repository full name.')
        booleanParam(name: 'RUN_ACCEPTANCE', defaultValue: false, description: 'Explicit operator opt-in; the Job DSL also disables this job until its tenant and credential are provisioned.')
    }

    environment {
        CANONICAL_REPOSITORY = 'AdrianSilaghi/terraform-provider-danubedata'
        SOURCE_URL = 'https://github.com/AdrianSilaghi/terraform-provider-danubedata.git'
        GO_IMAGE = 'golang:1.24.12-bookworm@sha256:44dd2dbf7b34b282ccd04e88cdf81dc93d38812ffd91c47cca8a11736860f55e'
        VERIFIED_MAIN_REF = 'refs/remotes/origin/main'
    }

    stages {
        stage('Fail closed unless explicitly enabled') {
            steps {
                script {
                    if (env.JOB_NAME != 'terraform-provider-danubedata-acceptance/main') {
                        error("This trusted pipeline cannot run as job ${env.JOB_NAME ?: 'unset'}")
                    }
                    if (!params.RUN_ACCEPTANCE) {
                        error('Acceptance execution is disabled by default; provision the quota-limited tenant, enable the job, and opt in explicitly')
                    }
                    if (params.SOURCE_REPOSITORY.trim() != env.CANONICAL_REPOSITORY) {
                        error("Unexpected source repository: ${params.SOURCE_REPOSITORY ?: 'unset'}")
                    }
                    if (params.SOURCE_REF.trim() != 'refs/heads/main') {
                        error("Acceptance tests require refs/heads/main, got ${params.SOURCE_REF ?: 'unset'}")
                    }
                    if (!(params.SOURCE_SHA.trim() ==~ /[0-9a-fA-F]{40}/)) {
                        error("Invalid SOURCE_SHA: ${params.SOURCE_SHA ?: 'unset'}")
                    }
                }
            }
        }

        stage('Verify protected main and run acceptance') {
            agent { label 'trusted-build' }
            steps {
                deleteDir()
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: env.VERIFIED_MAIN_REF]],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [[$class: 'CloneOption', noTags: true, shallow: false]],
                    userRemoteConfigs: [[
                        url: env.SOURCE_URL,
                        refspec: '+refs/heads/main:refs/remotes/origin/main'
                    ]]
                ])

                script {
                    String checkedOutSha = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    String fetchedMainSha = sh(script: "git rev-parse '${env.VERIFIED_MAIN_REF}'", returnStdout: true).trim()
                    if (!checkedOutSha.equalsIgnoreCase(fetchedMainSha) ||
                        !fetchedMainSha.equalsIgnoreCase(params.SOURCE_SHA.trim())) {
                        error("Acceptance checkout ${checkedOutSha} is not exact requested main tip ${params.SOURCE_SHA}")
                    }
                    int trustedMainStatus = sh(
                        script: "git merge-base --is-ancestor '${params.SOURCE_SHA.trim()}' '${env.VERIFIED_MAIN_REF}'",
                        returnStatus: true
                    )
                    if (trustedMainStatus != 0) {
                        error("SOURCE_SHA ${params.SOURCE_SHA} is not trusted main history")
                    }
                }

                withCredentials([string(
                    credentialsId: 'terraform-provider-acceptance-api-token',
                    variable: 'DANUBEDATA_API_TOKEN'
                )]) {
                    sh '''
                        set -eu
                        set +x
                        [ -n "$DANUBEDATA_API_TOKEN" ] || {
                            printf 'DANUBEDATA_API_TOKEN is empty; refusing to claim acceptance success\n' >&2
                            exit 1
                        }
                        docker run --rm --platform linux/amd64 \
                            --user "$(id -u):$(id -g)" \
                            -e GOCACHE=/tmp/go-build \
                            -e GOMODCACHE=/tmp/go-mod \
                            -e TF_ACC=1 \
                            -e DANUBEDATA_API_TOKEN \
                            -v "$WORKSPACE:/workspace" \
                            -w /workspace \
                            "$GO_IMAGE" \
                            go test -v -timeout 60m ./internal/resources/... ./internal/datasources/...
                    '''
                }
            }
        }
    }
}
